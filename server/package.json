{
  "name": "@smartpark/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --watch src --legacy-watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "test": "jest --testPathPatterns=integration --forceExit",
    "test:coverage": "jest --testPathPatterns=integration --forceExit --coverage",
    "test:watch": "jest --testPathPatterns=integration --forceExit --watch",
    "seed:parkings": "node src/scripts/seedParkings.js",
    "seed:parkings:fresh": "SEED_CLEAR=true node src/scripts/seedParkings.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.4.1",
    "google-auth-library": "9.15.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.0.1",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "openai": "^6.42.0",
    "razorpay": "^2.9.6",
    "socket.io": "4.8.1",
    "xss-clean": "^0.1.4",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^9.39.2",
    "@jest/globals": "^30.4.1",
    "babel-jest": "^30.4.1",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "collectCoverageFrom": [
      "src/controllers/**/*.js",
      "src/services/**/*.js",
      "src/middleware/**/*.js",
      "!src/**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 15
      },
      "src/middleware/validateRequest.js": {
        "lines": 100
      },
      "src/middleware/authorizeRoles.js": {
        "lines": 70
      }
    }
  }
}

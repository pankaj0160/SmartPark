{
  "name": "smartpark",
  "version": "0.1.0",
  "private": true,
  "description": "Smart parking slot rental and availability platform.",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "lint": "npm run lint --workspace client && npm run lint --workspace server",
    "test": "npm run test --workspace server && npm run test --workspace client"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "docx": "^9.7.1"
  },
  "main": "generate_report.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pankaj0160/SmartPark.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/pankaj0160/SmartPark/issues"
  },
  "homepage": "https://github.com/pankaj0160/SmartPark#readme"
}
